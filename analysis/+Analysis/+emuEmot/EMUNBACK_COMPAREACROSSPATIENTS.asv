        Gc.FontSize = 20;
        Gc.YLabel.String = varTested;
        Gc.YLabel.FontSize = 24;
        %Gc.XTickLabel = {(nameXXEm{1}); (nameXXId{1}); (nameYYEm{1}); (nameYYId{1}); (nameZZEm{1}); (nameZZId{1})};
