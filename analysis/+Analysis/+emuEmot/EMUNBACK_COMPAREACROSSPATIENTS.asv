stdYYId = nanstd(yyId);
stdZZId = nanstd(zzId);
TstTempKW = table(nameTable, meanXXEm, stdXXEm, meanXXId, stdXXId, meanYYEm, stdYYEm,  meanYYId, stdYYId, meanZZEm, stdZZEm, meanZZId, stdZZId, pvalue, testDone);
