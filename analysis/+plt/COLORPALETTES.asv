%% alternate with sports colors

colorTempTest = {'#13294B', '#7BAFD4', '#30bc18', '#63f807', '#4E8BC4', '#96CBFC', '#C2E1FC', ' #FFC2D9', "#'#65bda5', '#4E2A84' };
for ii = 1:length(colorTempTest)
    str = colorTempTest{ii};
    C(ii,:) = sscanf(str(2:end),'%2x%2x%2x',[1 3])/255;
end

C(end-1,:) = [164, 149, 195];

figure
X = repmat(10,1,length(C));
Y = 1:length(C);
bb = bar(Y,X);
bb.FaceColor = 'flat';
